# FactoryMatch Production Environment Template
# Copy to .env.production on production host and fill in secrets

# Node Environment
NODE_ENV=production
PORT=3000

# Database (PostgreSQL 16)
POSTGRES_USER=factorymatch_admin
POSTGRES_PASSWORD=generate_a_secure_random_db_password_here
POSTGRES_DB=factorymatch_prod
DATABASE_URL=postgresql://factorymatch_admin:generate_a_secure_random_db_password_here@postgres:5432/factorymatch_prod?schema=public

# Security Secrets (Must be at least 32 characters long)
COOKIE_SECRET=generate_a_min_32_char_cryptographically_secure_cookie_secret
JWT_ACCESS_SECRET=generate_a_min_32_char_cryptographically_secure_access_secret
JWT_REFRESH_SECRET=generate_a_min_32_char_cryptographically_secure_refresh_secret

# CORS & Domains
CORS_ORIGIN=https://app.factorymatch.in
NEXT_PUBLIC_API_URL=https://api.factorymatch.in/api/v1

# Razorpay Integration (Live credentials)
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
RAZORPAY_KEY_SECRET=your_actual_key_secret
RAZORPAY_WEBHOOK_SECRET=your_actual_webhook_signing_secret

# Cloudflare / R2 Storage for Factory Compliance Documents
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=factorymatch-documents-prod
