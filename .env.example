# Application Environment
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3001

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=factorymatch
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/factorymatch?schema=public

# Security Secrets (Must be at least 16 characters in production)
COOKIE_SECRET=change-this-in-production-cookie-secret
JWT_ACCESS_SECRET=change-this-in-production-jwt-access-secret
JWT_REFRESH_SECRET=change-this-in-production-jwt-refresh-secret

# Cloudflare R2 / S3 Storage (for Slice 2 doc uploads)
R2_ACCOUNT_ID=mock-r2-account-id
R2_ACCESS_KEY_ID=mock-r2-access-key
R2_SECRET_ACCESS_KEY=mock-r2-secret-key
R2_BUCKET_NAME=factorymatch-documents
R2_PUBLIC_URL=https://documents.factorymatch.in

# Razorpay (for Slice 6 payments)
RAZORPAY_KEY_ID=rzp_test_mock_key
RAZORPAY_KEY_SECRET=rzp_test_mock_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_mock
