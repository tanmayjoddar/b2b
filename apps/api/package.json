{
  "name": "@factorymatch/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n TSC,API -c blue.bold,green.bold \"tsc -w -p tsconfig.build.json --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "start": "node dist/main.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@factorymatch/shared": "workspace:*",
    "@nestjs/common": "^10.4.1",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.1",
    "@nestjs/platform-express": "^10.4.1",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^5.19.1",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "nestjs-pino": "^4.1.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@factorymatch/config": "workspace:*",
    "@nestjs/testing": "^10.4.22",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.5.4",
    "@types/supertest": "^6.0.2",
    "concurrently": "^10.0.6",
    "pino-pretty": "^11.2.2",
    "prisma": "^5.19.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "unplugin-swc": "^2.0.0",
    "vitest": "^2.0.5"
  }
}
